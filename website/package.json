{
  "name": "qcml-v2",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "content:audit": "node scripts/generate-lesson-content-audit.mjs",
    "check:lessons": "node scripts/validate-published-lessons.mjs",
    "test:engine": "node scripts/test-quantum-engine.mjs && node scripts/test-practice-answers.mjs",
    "check:quick": "npm run test:engine && npm run check:lessons && npm run typecheck && next build --no-lint",
    "check:full": "npm run test:engine && npm run check:lessons && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@types/three": "^0.184.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.1.7",
    "katex": "^0.16.10",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.3.0",
    "three": "^0.184.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.3",
    "typescript": "^5"
  }
